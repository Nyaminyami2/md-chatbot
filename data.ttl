<https://example.org/excel-rdf/cell/Instance/F117> a ex:Cell ;
    ex:cellReference "F117" ;
    ex:cellType "s" ;
    ex:cellValue "혼인 무효	혼인이 처음부터 성립하지 않았던 것으로 돌리는 절차로, 이미 성립한 혼인을 끝내는 이혼과 다르다. 영어 명칭: annulment." ;
    ex:columnNumber 6 ;
    ex:rowNumber 117 .

<https://example.org/excel-rdf/cell/Instance/F118> a ex:Cell ;
    ex:cellReference "F118" ;
