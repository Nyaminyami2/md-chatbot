md:T073 a rdf:Statement ;
    rdf:object md:A00031 ;
    rdf:predicate md:precedes ;
    rdf:subject md:A00067 ;
    rdfs:comment "명소민과 주스팩의 접촉은 상자에 있던 주스 팩이 없어짐에 선행한다." .

md:T074 a rdf:Statement ;
    rdf:object md:A00056 ;
    rdf:predicate md:precedes ;
    rdf:subject md:A00031 ;
