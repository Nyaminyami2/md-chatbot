# MD팀 데이터셋 (『똑 닮은 딸』 1~2화 딜레마 데이터)
# 출처: 고려대학교 디지털인문학응용 수업 데이터셋(Dilemma2602, 11.10 최종 수정본)의 md-Instance, md-triple 시트
# 변환: 엑셀 셀 단위 RDF를 노드·관계 단위 RDF로 다시 구성함 (Claude Opus 5.5로 변환, 내용은 바꾸지 않음)
@prefix dm: <https://example.org/dm/> .
@prefix md: <https://example.org/md/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .

md:A00032 a dm:Scene ;
    rdfs:label "MD_E01_S04" ;
    rdfs:comment "길소명이 심폐소생술을 했을 때 코나 입에서 물이 나오지 않았음을 논거로 명소민이 길명진을  죽였다고 의심하기 시작한다." ;
    dm:groupName "장면" .

md:A00033 a dm:Scene ;
    rdfs:label "MD_E01_S05" ;
    rdfs:comment "길소명은 손시윤과 통화하며 명소민에 대한 의심을 드러내고, 길명진의 주머니에 있던 빈 주스팩을 가져왔음을 밝힌다. 빈 주스팩을 학교에 가져가기로 한다." ;
    dm:groupName "장면" .

md:A00034 a dm:Scene ;
    rdfs:label "MD_E01_S06" ;
    rdfs:comment "길소명이 잠든 후 명소민이 길소명의 방에 들어와 빈 주스팩을 건들인다." ;
    dm:groupName "장면" .

md:A00035 a dm:Scene ;
    rdfs:label "MD_E02_S01" ;
    rdfs:comment "길소명이 빈 주스 팩을 잃어버린다." ;
    dm:groupName "장면" .

md:A00036 a dm:Scene ;
    rdfs:label "MD_E02_S03" ;
    rdfs:comment "길소명과 손시윤이 명소민의 집에 빈 주스 팩을 찾으러 간다. 이때 명소민이 길소명에게 찾던 것을 책상 위에 올려뒀다는 문자를 보내고, 책상 위에는 빈 주스 팩이 있다." ;
    dm:groupName "장면" .

md:A00037 a dm:Scene ;
    rdfs:label "MD_E02_S04" ;
    rdfs:comment "길소명과 손시윤이 빈 주스 팩을 가지고 경찰서를 찾아가지만 길소명은 패닉이 와서 제대로 진술하지 못하고, 조사가 종결된다." ;
    dm:groupName "장면" .

md:A00038 a dm:Scene ;
    rdfs:label "MD_E02_S05" ;
    rdfs:comment "길소명이 복일천 공원에 주스팩을 버린다." ;
    dm:groupName "장면" .

md:A00041 a dm:Object ;
    rdfs:label "사과주스" ;
    rdfs:comment "길명진이 죽기 전 명소민이 길명진에게 준 것이다." ;
    dm:groupName "사물" .

md:A00045 a dm:Emotion ;
    rdfs:label "슬픔(길소명)" ;
    rdfs:comment "길소명이 느끼는 행복" ;
    dm:groupName "감정" .

md:A00047 a dm:Emotion ;
    rdfs:label "혐오(길소명)" ;
    rdfs:comment "길소명이 느끼는 행복" ;
    dm:groupName "감정" .

md:A00049 a dm:Emotion ;
    rdfs:label "슬픔(명소민)" ;
    rdfs:comment "명소민이 느끼는 슬픔" ;
    dm:groupName "감정" .

md:A00050 a dm:Emotion ;
    rdfs:label "행복(명소민)" ;
    rdfs:comment "명소민이 느끼는 행복" ;
    dm:groupName "감정" .

md:A00064 a dm:Place ;
    rdfs:label "명소민의 집" ;
    rdfs:comment "명소민, 길소명, 길명진이 사는 곳이며, 주스팩을 숨김/주스팩이 사라짐/주스팩 재등장 사건의 배경이다." ;
    dm:groupName "장소" .

md:T001 a rdf:Statement ;
    rdf:object md:A00001 ;
    rdf:predicate md:hasDaughter ;
    rdf:subject md:A00002 ;
    rdfs:comment "명소민의 딸은 길소명이다." .

md:T002 a rdf:Statement ;
    rdf:object md:A00003 ;
    rdf:predicate md:hasSon ;
    rdf:subject md:A00002 ;
    rdfs:comment "명소민이 아들은 길명진이다." .

md:T003 a rdf:Statement ;
    rdf:object md:A00017 ;
    rdf:predicate dm:hasAlternative ;
    rdf:subject md:A00018 ;
    rdfs:comment "주스 팩을 경찰서에 다시 가져가는 선택지의 반대편에는 주스 팩을 버리는 선택지가 있다." .

md:T004 a rdf:Statement ;
    rdf:object md:A00016 ;
    rdf:predicate dm:isOptionOf ;
    rdf:subject md:A00018 ;
    rdfs:comment "이 선택지는 길소명이 주스 팩을 다시 경찰에 가져갈지 고민하는 딜레마에 속한다." .

md:T005 a rdf:Statement ;
    rdf:object md:A00016 ;
    rdf:predicate dm:isOutcomeOf ;
    rdf:subject md:A00019 ;
    rdfs:comment "길소명이 주스 팩을 버린 일은 이 딜레마에서 실제로 일어난 결과이다." .

md:T006 a rdf:Statement ;
    rdf:object md:A00057 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00020 ;
    rdfs:comment "명소민이 주스 팩을 가져갔다는 의심은 길소명이 주스 팩 ①과 주스 팩 ②가 다를 수 있다고 의심하는 근거가 된다." .

md:T007 a rdf:Statement ;
    rdf:object md:A00023 ;
    rdf:predicate md:receivedAward ;
    rdf:subject md:A00021 ;
    rdfs:comment "이담은 2020 지상최대공모전 2기 우수상을 수상하였다." .

md:T008 a rdf:Statement ;
    rdf:object md:A00024 ;
    rdf:predicate md:receivedAward ;
    rdf:subject md:A00021 ;
    rdfs:comment "이담은 제 1회 SC웹툰어워즈 신인웹툰작가상을 수상하였다." .

md:T009 a rdf:Statement ;
    rdf:object md:A00025 ;
    rdf:predicate md:receivedAward ;
    rdf:subject md:A00022 ;
    rdfs:comment "똑 닮은 딸은 대한민국콘텐츠대상 만화부문 한국콘텐츠진흥원장상을 수상하였다." .

md:T010 a rdf:Statement ;
    rdf:object md:A00026 ;
    rdf:predicate md:receivedAward ;
    rdf:subject md:A00022 ;
    rdfs:comment "똑 닮은 딸은 2024 오늘의 우리만화 문화체육관광부 장관상을 수상하였다." .

md:T011 a rdf:Statement ;
    rdf:object md:A00027 ;
    rdf:predicate schema:hasPart ;
    rdf:subject md:A00022 ;
    rdfs:comment "222화중 1화는 똑 닮은 딸 전체 222화 가운데 첫 회차는 1화이다." .

md:T012 a rdf:Statement ;
    rdf:object md:A00028 ;
    rdf:predicate schema:hasPart ;
    rdf:subject md:A00022 .

md:T013 a rdf:Statement ;
    rdf:object md:A00029 ;
    rdf:predicate schema:hasPart ;
    rdf:subject md:A00027 ;
    rdfs:comment "1화의 첫 번째 장면은 MD_E01_S01이다." .

md:T014 a rdf:Statement ;
    rdf:object md:A00030 ;
    rdf:predicate dm:nextScene ;
    rdf:subject md:A00028 ;
    rdfs:comment "MD_E01_S01 다음에 이어지는 장면은 MD_E01_S02이다." .

md:T015 a rdf:Statement ;
    rdf:object md:A00005 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00027 ;
    rdfs:comment "1화에는 명소민과 길명진의 불화가 그려진다." .

md:T016 a rdf:Statement ;
    rdf:object md:A00006 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00027 ;
    rdfs:comment "1화에는 길명진의 죽음이 그려진다." .

md:T017 a rdf:Statement ;
    rdf:object md:A00007 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00027 ;
    rdfs:comment "1화에는 길명진이 익사한 것이 아니라는 길소명의 의심이 드러난다." .

md:T018 a rdf:Statement ;
    rdf:object md:A00007 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00008 ;
    rdfs:comment "인공호흡을 할 때 길명진의 입에서 물이 나오지 않는 것을 본 길소명은 길명진이 물에 빠져 죽은 것이 아니라고 의심하게 된다." .

md:T019 a rdf:Statement ;
    rdf:object md:A00006 ;
    rdf:predicate md:precedes ;
    rdf:subject md:A00009 ;
    rdfs:comment "길명진이 사과 주스를 마신 일은 길명진의 죽음보다 앞서 일어났다." .

md:T020 a rdf:Statement ;
    rdf:object md:A00010 ;
    rdf:predicate dm:isSuspectedIn ;
    rdf:subject md:A00009 ;
    rdfs:comment "길명진이 마신 사과 주스는 명소민이 독을 탔다는 길소명의 의심을 받는다." .

md:T021 a rdf:Statement ;
    rdf:object md:A00010 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00008 ;
    rdfs:comment "인공호흡을 할 때 물이 나오지 않았다는 점은, 길명진이 익사가 아닌 다른 이유로 죽었을 수 있다는 의심의 근거가 된다." .

md:T022 a rdf:Statement ;
    rdf:object md:A00004 ;
    rdf:predicate md:hasFriend ;
    rdf:subject md:A00001 ;
    rdfs:comment "길소명의 친구는 손시윤이다." .

md:T023 a rdf:Statement ;
    rdf:object md:A00031 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00028 ;
    rdfs:comment "2화에서 길소명의 주스 팩이 사라진다." .

md:T024 a rdf:Statement ;
    rdf:object md:A00014 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00028 ;
    rdfs:comment "2화에서 길소명이 빈 주스 팩을 가지고 경찰서에 방문한다." .

md:T025 a rdf:Statement ;
    rdf:object md:A00015 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00028 ;
    rdfs:comment "2화에서 길소명이 경찰서에서 패닉이 와 진술을 제대로 하지 못하고, 사건이 종결된다." .

md:T026 a rdf:Statement ;
    rdf:object md:A00019 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00028 ;
    rdfs:comment "2화에서 길소명은 경찰서에 가서 조사받는 것을 포기하며 빈 주스 팩을 버리고, 명소민에 대한 복수를 다짐한다." .

md:T027 a rdf:Statement ;
    rdf:object md:A00039 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00028 ;
    rdfs:comment "2화에서 명소민이 길소명에게 경찰서에 간 것을 알고 있다는 것을 암시하고, 강제로 사과주스를 다  마시게 한다." .

md:T028 a rdf:Statement ;
    rdf:object md:A00010 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00027 ;
    rdfs:comment "1화에서 길소명은 명소민이 사과 주스에 독을 탔다고 의심하기 시작한다." .

md:T029 a rdf:Statement ;
    rdf:object md:A00020 ;
    rdf:predicate dm:depicts ;
    rdf:subject md:A00028 ;
    rdfs:comment "2화에서 길소명은 명소민이 주스 팩을 가져갔다고 의심한다." .

md:T030 a rdf:Statement ;
    rdf:object md:A00014 ;
    rdf:predicate dm:isTakenTo ;
    rdf:subject md:A00012 ;
    rdfs:comment "명소민이 책상위에 올려둔 주스팩은 경찰서에 방문할 때 가져갔다." .

md:T031 a rdf:Statement ;
    rdf:object md:A00008 ;
    rdf:predicate dm:isPackedDuring ;
    rdf:subject md:A00011 ;
    rdfs:comment "길소명이 원래 경찰서에 가져가려던 주스 팩을 챙긴 것은 명진의 사고 발생과 인공호흡 당시이다." .

md:T032 a rdf:Statement ;
    rdf:object md:A00040 ;
    rdf:predicate dm:HappenedAt ;
    rdf:subject md:A00008 ;
    rdfs:comment "길명진의 사고 발생과 인공호흡은 개울에서 일어났다." .

md:T033 a rdf:Statement ;
    rdf:object md:A00013 ;
    rdf:predicate dm:HappenedAt ;
    rdf:subject md:A00015 ;
    rdfs:comment "경찰서에서의 진술은 경찰서에서 이루어진다." .

md:T034 a rdf:Statement ;
    rdf:object md:A00042 ;
    rdf:predicate dm:happenedAt ;
    rdf:subject md:A00019 ;
    rdfs:comment "길소명의 주스 팩 폐기는 복일천 공원에서 일어났다." .

md:T035 a rdf:Statement ;
    rdf:object md:A00002 ;
    rdf:predicate dm:BeDirectedToward ;
    rdf:subject md:A00044 ;
    rdfs:comment "길소명은 작품 내내 명소민에게 공포를 느끼고 있다." .

md:T036 a rdf:Statement ;
    rdf:object md:A00002 ;
    rdf:predicate dm:BeDirectedToward ;
    rdf:subject md:A00046 ;
    rdfs:comment "길소명은 명소민에게 분노하고 있다." .

md:T037 a rdf:Statement ;
    rdf:object md:A00044 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00056 ;
    rdfs:comment "다시 등장한 주스팩은 길소명을 공포에 떨게 한다." .

md:T038 a rdf:Statement ;
    rdf:object md:A00048 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00056 ;
    rdfs:comment "주스팩의 예상치 못한 등장에 명소민은 놀란다." .

md:T039 a rdf:Statement ;
    rdf:object md:A00057 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00056 ;
    rdfs:comment "길소명은 명소민의 손을 거쳐 다시 돌아온 주스 팩에 어떠한 조치가 취해졌을 수 있다고 의심한다." .

md:T040 a rdf:Statement ;
    rdf:object md:A00051 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00005 ;
    rdfs:comment "길명진과의 불화는 명소민이 길명진에게 분노하게 한다." .

md:T041 a rdf:Statement ;
    rdf:object md:A00052 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00005 ;
    rdfs:comment "길명진과의 불화는 명소민이 길명진을 혐오하게 한다." .

md:T042 a rdf:Statement ;
    rdf:object md:A00015 ;
    rdf:predicate dm:Cause ;
    rdf:subject md:A00044 ;
    rdfs:comment "소명은 명소민에 대한 공포로 인해 경찰서에서 제대로 진술하지 못한다." .

md:T043 a rdf:Statement ;
    rdf:object md:A00016 ;
    rdf:predicate dm:isOptionOf ;
    rdf:subject md:A00017 ;
    rdfs:comment "이 선택지는 길소명이 주스 팩을 다시 경찰에 가져갈지 고민하는 딜레마에 속한다." .

md:T044 a rdf:Statement ;
    rdf:object md:A00044 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00010 ;
    rdfs:comment "이 사건으로 인해 길소명은 명소민에게 공포를 느낀다." .

md:T045 a rdf:Statement ;
    rdf:object md:A00046 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00010 ;
    rdfs:comment "이 사건으로 인해 길소명은 명소민에게 분노한다." .

md:T046 a rdf:Statement ;
    rdf:object md:A00003 ;
    rdf:predicate dm:BeDirectedToward ;
    rdf:subject md:A00051 ;
    rdfs:comment "명소민은 길명진에게 분노한다." .

md:T047 a rdf:Statement ;
    rdf:object md:A00003 ;
    rdf:predicate dm:BeDirectedToward ;
    rdf:subject md:A00052 ;
    rdfs:comment "명소민은 길명진을 혐오한다." .

md:T048 a rdf:Statement ;
    rdf:object md:A00002 ;
    rdf:predicate dm:BeDirectedToward ;
    rdf:subject md:A00054 ;
    rdfs:comment "길명진은 명소민에게 공포를 느낀다." .

md:T049 a rdf:Statement ;
    rdf:object md:A00053 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00005 ;
    rdfs:comment "명소민과의 불화는 길명진이 명소민에게 분노하게 한다." .

md:T050 a rdf:Statement ;
    rdf:object md:A00055 ;
    rdf:predicate dm:OccurredSimultaneously ;
    rdf:subject md:A00058 ;
    rdfs:comment "길소명은 눈물흘리는 명소민을 보며 우는 척 하며 웃고 있다고 의심한다." .

md:T051 a rdf:Statement ;
    rdf:object md:A00010 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00058 ;
    rdfs:comment "명소민이 웃는 것 같다는 의심은 명소민이 사과주스에 독을 탔다는 의심으로 이어진다." .

md:T052 a rdf:Statement ;
    rdf:object md:A00019 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00059 ;
    rdfs:comment "명소민을 배신하면 이때까지의 보호를 잃는다는 생각이 주스팩을 버리는 근거가 되었다." .

md:T053 a rdf:Statement ;
    rdf:object md:A00014 ;
    rdf:predicate dm:Cause ;
    rdf:subject md:A00061 ;
    rdfs:comment "길소명은 길명진의 죽음에 대한 진실이 밝혀지길 바라기에 경찰서에 방문했다." .

md:T054 a rdf:Statement ;
    rdf:object md:A00062 ;
    rdf:predicate dm:Cause ;
    rdf:subject md:A00061 ;
    rdfs:comment "길소명은 길명진의 죽음에 대한 진실이 밝혀지길 바라기에 주스팩을 숨겼다." .

md:T055 a rdf:Statement ;
    rdf:object md:A00062 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00007 ;
    rdfs:comment "길명진은 익사한 것이 아니라는 의심은 길소명이 주스팩을 숨기는 근거가 되었다." .

md:T056 a rdf:Statement ;
    rdf:object md:A00063 ;
    rdf:predicate dm:Cause ;
    rdf:subject md:A00005 ;
    rdfs:comment "길명진과의 불화는 명소민으로 하여금 길명진이 없었으면 좋았을 것이라고 반복해서 말하게 한다." .

md:T057 a rdf:Statement ;
    rdf:object md:A00010 ;
    rdf:predicate dm:isEvidenceFor ;
    rdf:subject md:A00063 ;
    rdfs:comment "길명진이 없었으면 좋겠다는 명소민의 지속적인 발화는 길소명이 명소민이 사과주스에 독을 탔다고 의심하는 근거가 된다." .

md:T058 a rdf:Statement ;
    rdf:object md:A00043 ;
    rdf:predicate dm:evoke ;
    rdf:subject md:A00061 ;
    rdfs:comment "길명진의 죽음에 대한 진실이 밝혀지면 길소명은 행복해질것이다." .

md:T059 a rdf:Statement ;
    rdf:object md:A00014 ;
    rdf:predicate dm:ParticipatedIn ;
    rdf:subject md:A00001 ;
    rdfs:comment "경찰서에 방문한 것은 길소명과 손시윤이다." .

md:T060 a rdf:Statement ;
    rdf:object md:A00014 ;
    rdf:predicate dm:ParticipatedIn ;
    rdf:subject md:A00004 ;
    rdfs:comment "경찰서에 방문한 것은 길소명과 손시윤이다." .

md:T061 a rdf:Statement ;
    rdf:object md:A00010 ;
